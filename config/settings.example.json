{
  "cleanupPeriodDays": 120,
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$HOME/.claude/hooks/task-contract.py", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Skill", "hooks": [ { "type": "command", "command": "$HOME/.claude/hooks/self-improve-log.py", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "$HOME/.claude/hooks/self-improve-log.py", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.claude/hooks/self-improve-log.py", "timeout": 5 } ] }
    ]
  }
}
